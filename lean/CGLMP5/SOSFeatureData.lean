import CGLMP5.SOSCompressedData

namespace CGLMP5.SOSFinite

set_option Elab.async false
set_option maxHeartbeats 0
set_option maxRecDepth 200000

abbrev Feature := Fin 135 × Fin 20

def computedFeatures (j : Fin 14) : List (Word × Feature) :=
  (localTerms j).flatMap fun t => (localTerms j).flatMap fun u =>
      let f : Feature := (gramIndex j (localCore j t.2.1) (localCore j u.2.1), phaseDifference t.2.2 u.2.2)
      [(Word.mul (Word.adjoint t.1) u.1, f), (Word.mul u.1 (Word.adjoint t.1), f)]

